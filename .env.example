# =====================================================================
# คัดลอกไฟล์นี้เป็น .env ก่อนรัน:   cp .env.example .env
# แล้วเปลี่ยนรหัสผ่านทุกตัวเป็นของตัวเอง  (.env ถูก .gitignore ไว้ ไม่ขึ้น GitHub)
# ห้ามใช้อักขระพิเศษ @ : / ? # % ในรหัสผ่าน เพราะจะทำให้ connection URI พัง
# =====================================================================

# user id ที่ container ใช้เขียนไฟล์ลง ./logs  (Windows/Mac ใช้ 50000 ได้เลย,
# Linux ให้ใส่ผลของคำสั่ง  id -u)
AIRFLOW_UID=50000

# บัญชีเข้าหน้า Airflow UI  http://localhost:8090
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin

# รหัสผ่านฐานข้อมูล metadata ของ Airflow เอง
AIRFLOW_DB_PASSWORD=change_me_airflow_db

# ฐานข้อมูลปลายทาง (เก็บข้อมูลอัตราแลกเปลี่ยน, dashboard อ่านจากที่นี่)
TARGET_DB_NAME=fx_db
TARGET_DB_USER=fx_user
TARGET_DB_PASSWORD=change_me_fx_db
